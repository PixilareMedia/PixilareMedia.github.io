<style>
  /*Main Panel*/
  #navigation-panel {
    background-color: var(--navigation-background);
    padding-top: .5em;
    padding-bottom: .5em;
    overflow-y: hidden;
    overflow-x: scroll;
  }
  #navigation-list {
    display: grid;
    grid-template-columns: repeat(8, auto);
    grid-template-rows: 1;
    column-gap: 0;
    row-gap: 0;

    list-style: none;
    font-size: 20px;
    padding-left: 0em;
    padding-right: 0em;
    text-align: center;
    align-items: center;
  }
  #navigation-image {
    width: 4em;
    height: auto;
  }

  /*Main Panel Categories*/
  .navigation-category {
    margin: 0em;
    background: transparent;
    color: var(--text);
    border: 0em;
    font-size: 1.5em;
    font-family: 'segoe script';
  }
  .navigation-category:hover {
    color: var(--link-hover);
    cursor: pointer;
  }
  .navigation-category > p {
    margin: 0em;
  }

  /*Panel Links & Spacing*/
  .navigation-link {
    color: var(--text);
    text-decoration: none;
    font-size: 20px;
  }
  .navigation-link:hover {
    color: var(--link-hover);
    cursor: pointer;
  }
  .navigation-space {
    margin-left: 0.5em;
    margin-right: 0.5em;
  }
  
  /*Sub Panels*/
  #navigation-sub-panel {
    position: absolute;
    left: 25%;
    width: 50%;
  }
  .navigation-panel-sub {
    display: grid;
    grid-template-columns: repeat(4, auto);
    grid-template-rows: repeat(2, auto);
    column-gap: 0;
    row-gap: 0;

    list-style: none;
    align-items: center;
    text-align: center;
    background-color: var(--navigation-background);
    border: 5px;
    border-style: solid;
    border-color: var(--navigation-background-border);
    border-radius: 25px;
    padding-bottom: 1em;
  }
  
  /*Grid Layouts for each of the sub panels*/
  /*Pixilare sub panel*/
  #navigation-company > .navigation-panel-sub > #navigation-company-all {
    grid-area: 1 / 1 / 2 / 5;
  }
  #navigation-company > .navigation-panel-sub > #navigation-company-links {
    grid-area: 2 / 1 / 3 / 2;
  }
  #navigation-company > .navigation-panel-sub > #navigation-company-team {
    grid-area: 2 / 2 / 3 / 4;
  }
  #navigation-company > .navigation-panel-sub > #navigation-company-jobs {
    grid-area: 2 / 4 / 3 / 5;
  }
  
  /*Interactive sub panel*/
  #navigation-studios-interactive > .navigation-panel-sub > #navigation-studios-interactive-all {
    grid-area: 1 / 1 / 2 / 5;
  }
  
  /*Modding sub panel*/
  #navigation-studios-modding > .navigation-panel-sub > #navigation-studios-modding-all {
    grid-area: 1 / 1 / 2 / 3;
  }
  #navigation-studios-modding > .navigation-panel-sub > #navigation-studios-modding-pixel-series {
    grid-area: 1 / 3 / 2 / 5;
  }
  #navigation-studios-modding > .navigation-panel-sub > #navigation-studios-modding-resourcepacks {
    grid-area: 2 / 1 / 3 / 2;
  }
  #navigation-studios-modding > .navigation-panel-sub > #navigation-studios-modding-modpacks {
    grid-area: 2 / 2 / 3 / 4;
  }
  #navigation-studios-modding > .navigation-panel-sub > #navigation-studios-modding-mods {
    grid-area: 2 / 4 / 3 / 5;
  }
  
  /*Softworks sub panel*/
  #navigation-studios-softworks > .navigation-panel-sub > #navigation-studios-softworks-all {
    grid-area: 1 / 1 / 2 / 5;
  }
  
  /*Animation sub panel*/
  #navigation-entertainment-animation > .navigation-panel-sub > #navigation-entertainment-animation-all {
    grid-area: 1 / 1 / 2 / 5;
  }
  
  /*Comics sub panel*/
  #navigation-entertainment-comics > .navigation-panel-sub > #navigation-entertainment-comics-all {
    grid-area: 1 / 1 / 2 / 5;
  }
  
  /*Pictures sub panel*/
  #navigation-entertainment-pictures > .navigation-panel-sub > #navigation-entertainment-pictures-all {
    grid-area: 1 / 1 / 2 / 5;
  }
</style>

<script>
  import { categoryButtonSetup, hideNavigationDivs } from "./navigation/categoryButtons.ts";
  
  document.addEventListener("DOMContentLoaded", navigationSetup)

  function navigationSetup() {
    categoryButtonSetup();
    hideNavigationDivs();
  }
</script>
<style>
  #pixel-ville-page {
    text-align: center;
		margin-bottom: 3em;
		margin-top: 1em;
  }
  #pixel-ville-page > h1 {
    margin-bottom: 1em;
  }
  .sections {
		border: 3px;
		border-color: var(--section-backgound-border);
		border-style: inset;
		border-radius: 25px;
		font-size: large;
		padding: 10px;
		margin: 5px;
		background-color: var(--section-backgound);
  }
  .external-links {
    text-decoration: none;
    color: var(--button-project-link);
  }
  .external-links:hover {
    color: var(--link-hover);
  }
  .landscape {
    width: 25%;
    height: auto;
    border: 3px;
    border-color: var(--image-border);
    border-style: double;
    border-radius: 10px;
  }
  #sub-section {
    display: flex;
    flex-direction: column;
    text-align: center;
    align-items: center;
  }
  #sub-section-contols {
    display: flex;
    flex-direction: row;
    width: 100%;
  }
  .sub-section-contols-align {
    width: 100%;
  }
  .download-mirror-list {
    list-style: none;
    padding: 0em;
    margin: 0em;
  }
  #mods-lists {
    display: flex;
    flex-direction: row;
  }
</style>

<script>
  import { categoryButtonSetup, hideCatagoryDivs } from "./pixel-ville/script.ts";
  
  document.addEventListener("DOMContentLoaded", navigationSetup)

  function navigationSetup() {
    categoryButtonSetup();
    hideCatagoryDivs();
  }
</script>
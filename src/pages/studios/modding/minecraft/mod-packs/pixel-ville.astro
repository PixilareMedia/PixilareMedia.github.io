---
import Layout from "../../../../../layouts/GenericLayout.astro";
import MirrorDownload from "../../../../../components/projects/MirrorDownloads.astro";
import ActionButton from "../../../../../components/projects/ActionButtons.astro";
import DownloadButton from "../../../../../components/projects/DownloadButtons.astro";
---

<Layout description="The Pixel Ville Minecraft Modpack Project." title="Pixel Ville - Modpacks - Minecraft - Modding - Pixilare Media">
  <div id="pixel-ville-page">
    <h1>Pixel Ville Modpack</h1>
    <div class="sections">
      <h2>About</h2>
      <p>Become the mayor of your very own village or city.</p>
      <p>The main premise is to get a working and successful city and to have a keen eye for design</p>
      <p>Store your personal items in a ME system create power to have it function</p>
      <p>Use the replay mod to show off your building skills</p>
      <p>Create a custom story-driven world with your friends</p>
      <p>And much more to come. . .</p>
      <p><a class="external-links" href="https://www.curseforge.com/minecraft/modpacks/pixel-ville" target="_blank">Download from CurseForge</a></p>
    </div>
    <div class="sections">
      <h2>Screenshots</h2>
      <img class="landscape" src="/images/projects/studios/modding/minecraft/mod-packs/pixel-ville/landscape1.png" alt="An image of some landscapes in Pixel Ville">
      <img class="landscape" src="/images/projects/studios/modding/minecraft/mod-packs/pixel-ville/landscape2.png" alt="An image of some landscapes in Pixel Ville">
      <img class="landscape" src="/images/projects/studios/modding/minecraft/mod-packs/pixel-ville/village1.png" alt="An image of a village in Pixel Village">
    </div>
    <div id="sub-section">
      <div id="sub-section-contols">
        <div class="sub-section-contols-align"></div>
        <div class="sections sub-section-contols-align">
          <ActionButton buttonID="downloads" buttonName="Downlaods (Mirror)"/>
        </div>
        <div class="sections sub-section-contols-align">
          <ActionButton buttonID="mods-list" buttonName="Mods List"/>
        </div>
        <div class="sub-section-contols-align"></div>
      </div>
      <div id="downloads-and-mods-list">

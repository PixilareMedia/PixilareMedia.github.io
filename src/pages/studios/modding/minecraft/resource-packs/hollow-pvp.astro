<style>
  #hollow-pvp-page {
    text-align: center;
		margin-bottom: 3em;
		margin-top: 1em;
  }
  #hollow-pvp-page > h1 {
    margin-bottom: 1em;
  }
  .sections {
		border: 3px;
		border-color: var(--section-backgound-border);
		border-style: inset;
		border-radius: 25px;
		font-size: large;
		padding: 10px;
		margin: 5px;
		background-color: var(--section-backgound);
  }
  .external-links {
    text-decoration: none;
    color: var(--button-project-link);
  }
  .external-links:hover {
    color: var(--link-hover);
  }
  .landscape {
    width: 25%;
    height: auto;
    border: 3px;
    border-color: var(--image-border);
    border-style: double;
    border-radius: 10px;
  }
  #sub-section {
    display: flex;
    flex-direction: column;
    text-align: center;
    align-items: center;
  }
  #sub-section-images {
    display: flex;
    flex-direction: row;
    width: 100%;
  }
  .sub-section-images-align {
    width: 100%;
  }
  .download-mirror-list {
    list-style: none;
    padding: 0em;
    margin: 0em;
  }
</style>

<script>
  import { categoryButtonSetup, hideDownloadsDivs } from "./hollow-pvp/script.ts";
  
  document.addEventListener("DOMContentLoaded", navigationSetup)

  function navigationSetup() {
    categoryButtonSetup();
    hideDownloadsDivs();
  }
</script>
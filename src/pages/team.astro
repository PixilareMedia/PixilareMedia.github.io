<style>
  #team-page {
    text-align: center;
		margin-bottom: 3em;
		margin-top: 1em;
  }
  #team-page > h1 {
    margin-bottom: 1em;
  }
  .member-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(34ch, 1fr));
    gap: 1rem;
    padding: 0em;
    margin-bottom: 2em;
  }
</style>